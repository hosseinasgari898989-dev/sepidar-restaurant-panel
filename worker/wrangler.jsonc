{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sepidar-restaurant-panel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "observability": { "enabled": true },

  // پنل رستوران‌دار از همین Worker و با همان دامنه سرو می‌شود: /panel/
  // (کوکی نشست HttpOnly فقط در حالت هم‌دامنه قابل اتکاست)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://hosseinasgari898989-dev.github.io,http://localhost:3000,http://localhost:5173",
    // شناسه رستورانی که توکن اولیه به آن تعلق دارد (سمت سرور تعیین می‌شود، نه مرورگر)
    "PANEL_RESTAURANT_ID": "main",
    // آدرس عمومی سایت مشتریان؛ QR فقط به این آدرس ساخته می‌شود
    "PUBLIC_SITE_URL": "https://hosseinasgari898989-dev.github.io/sepidar-restaurant-platform/",
    "SESSION_TTL_HOURS": "8"
  }

  // ⚠️ پایگاه داده D1 هنوز ساخته نشده است. پس از ساخت، این بخش را فعال کنید:
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "sepidar-db", "database_id": "<شناسه واقعی D1>" }
  // ]

  // ⚠️ توکن اولیه را هرگز اینجا ننویسید. فقط به‌صورت Secret:
  //   npx wrangler secret put SEPIDAR_PANEL_BOOTSTRAP_TOKEN
}
