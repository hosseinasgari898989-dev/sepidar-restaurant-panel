{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sepidar-restaurant-panel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": { "enabled": true },

  // استقرار Cloudflare Builds با دستور cd worker && npx wrangler deploy از ریشه ریپو اجرا می‌شود.
  // پنل رستوران‌دار از همین Worker و با همان دامنه سرو می‌شود: /panel/
  // (کوکی نشست HttpOnly فقط در حالت هم‌دامنه قابل اتکاست)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/panel/*"]
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://hosseinasgari898989-dev.github.io,http://localhost:3000,http://localhost:5173",
    // شناسه رستورانی که توکن اولیه به آن تعلق دارد (سمت سرور تعیین می‌شود، نه مرورگر)
    "PANEL_RESTAURANT_ID": "main",
    // آدرس عمومی سایت مشتریان؛ QR فقط به این آدرس ساخته می‌شود
    "PUBLIC_SITE_URL": "https://hosseinasgari898989-dev.github.io/sepidar-restaurant-platform/",
    "SESSION_TTL_HOURS": "8"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sepidar-db",
      "database_id": "3ba9f865-95b7-4a5a-b8f6-c256601f1b3a"
    }
  ]

  // ⚠️ توکن اولیه را هرگز اینجا ننویسید. فقط به‌صورت Secret:
  //   npx wrangler secret put SEPIDAR_PANEL_BOOTSTRAP_TOKEN
}

  // R2 storage requires one-time enablement in the Cloudflare Dashboard.
  // After the bucket is created, enable this binding and deploy:
  // "r2_buckets": [{ "binding": "FOOD_IMAGES", "bucket_name": "sepidar-food-images" }]
